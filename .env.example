# Lokale Entwicklung: cp .env.example .env
DATABASE_URL=postgres://postgres@localhost:5432/lapis
PORT=3000

# Optional: Railway Bucket (S3-kompatibel). Ohne diese Werte landen Bilder in ./.uploads
# BUCKET=
# ENDPOINT=https://t3.storageapi.dev
# REGION=auto
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# E-Mail (Passwort vergessen) über Resend – Railway erlaubt SMTP erst ab dem Pro-Plan.
# Ohne Schlüssel werden Mails lokal nur in der Konsole ausgegeben.
# RESEND_API_KEY=re_...
# MAIL_FROM=Lapis <hallo@deine-domain.ch>

# Optional
# PUBLIC_URL=https://lapis.example
# SESSION_DAYS=60
# MAX_UPLOAD_MB=12
# LOG_LEVEL=info
