{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "vite-plugin-pwa/react", "vite-plugin-pwa/info"]
  },
  "include": ["src/**/*", "../shared/**/*.ts", "vite.config.ts"]
}
